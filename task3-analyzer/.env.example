# Local development: the analysis runs on your own Ollama (the defaults).
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b

# Optional: a GitHub personal access token raises the API limit from 60 to 5,000 requests per hour.
# It needs no permissions (no scopes ticked) because only public data is read.
GITHUB_TOKEN=

# Deployed demo only (set these in the hosting platform's secrets, not here):
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here